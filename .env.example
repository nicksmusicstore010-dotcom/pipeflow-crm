# Supabase (created via Vercel Marketplace > Supabase).
# Easiest: `vercel link` then `vercel env pull .env.local` fills these in.
# Manual: Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The Vercel integration sets this legacy name instead; either one works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key — bypasses RLS. Server only (webhooks, jobs): NEVER prefix with NEXT_PUBLIC_.
# Supabase dashboard > Project Settings > API Keys > Secret keys.
# Legacy name SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public app URL (used in auth e-mail links when the request has no Origin header)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (workspace invites). Server only. Resend > API Keys ("Sending access" is enough).
RESEND_API_KEY=re_xxx
# Sender on a domain verified in Resend. Unset = Resend's test sender, which only
# delivers to the Resend account owner (the invite link is shown to copy instead).
# RESEND_FROM=PipeFlow <nao-responda@pipeflow.com.br>

# Stripe (plano Pro). Test mode keys while developing: Stripe dashboard > Developers > API keys.
# Secret key: server only, NEVER prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_xxx
# Publishable key (safe in the browser; not used yet — Checkout is a Stripe-hosted page).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Monthly price of the Pro product (Product catalog > Pro > price id).
STRIPE_PRO_PRICE_ID=price_xxx
# Webhook signing secret. Local: printed by
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Production: Developers > Webhooks > endpoint https://<domínio>/api/webhooks/stripe, events
# checkout.session.completed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed.
# The Customer Portal must be saved once in Settings > Billing > Customer portal (test mode too).
STRIPE_WEBHOOK_SECRET=whsec_xxx
