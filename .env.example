# Supabase (created via Vercel Marketplace > Supabase).
# Easiest: `vercel link` then `vercel env pull .env.local` fills these in.
# Manual: Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The Vercel integration sets this legacy name instead; either one works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key — bypasses RLS. Server only (webhooks, jobs): NEVER prefix with NEXT_PUBLIC_.
# Supabase dashboard > Project Settings > API Keys > Secret keys.
# Legacy name SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public app URL (used in auth e-mail links when the request has no Origin header)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
